ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Audio isolation (ElevenLabs neural cleanup before STT). Default on — set to off to skip.
ELEVENLABS_ISOLATION=on
# Max combined bytes for pre/post isolation A/B audio in API JSON (default 8MB).
# VOICE_COMPARE_MAX_BYTES=8000000
# Optional TTS/STT tuning (defaults: built-in voice + eleven_flash_v2_5 + fallbacks).
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_TTS_MAX_CHARS=10000
OPENAI_API_KEY=your_openai_api_key_here
# AI_MODE=rules — use "ai" only when an LLM backend is configured below.
AI_MODE=rules
UNIT_NAME=1st_Platoon_Alpha_Co

# LLM: point the AI toggle at your deployed Modal Llama (modal deploy <file>.py).
# MODAL_APP_NAME must exactly match modal.App("...") in that file — e.g.:
#   llama_sandbox_8b.py  → example-base-Meta-Llama-3-8B
#   llama-sandbox.py     → example-base-Meta-Llama-3-70B-Instruct
# LLM_BACKEND=modal
# MODAL_APP_NAME=example-base-Meta-Llama-3-8B
# Optional: MODAL_ENVIRONMENT_NAME=main   MODAL_CLASS_NAME=Model
# AI_MODE=ai
#
# Modal CLI + Python SDK auth (create a token in the Modal dashboard → Settings / API tokens).
# Prefer `modal token set` once per machine; or set both vars so FastAPI/python-dotenv can load them:
# MODAL_TOKEN_ID=ak-xxxx
# MODAL_TOKEN_SECRET=as-xxxx

# Or use OpenAI (omit MODAL_APP_NAME / LLM_BACKEND or set LLM_BACKEND=openai).
# LLM_BACKEND=openai
